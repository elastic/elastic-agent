{{- $beatHome := printf "%s/%s" "/usr/share" .BeatName -}}
#!/bin/bash

# Update umask to retain group write permissions on runtime directories: $root/tmp/default, $root/logs/default and $root/run/default
umask 0007

set -eo pipefail

# For information on the possible environment variables that can be passed into the container. Run the following
# command for information on the options that are available.
#
# `./elastic-agent container --help`
#

{{- if contains .Variant "complete" }}
# Chromium (browser monitors) ignores the system trust store and only reads its
# own NSS database. Import the CAs mounted in the standard location into it and
# keep it in sync while the container runs. Failures only warn: they must not
# stop the agent.
custom_ca_dir=/usr/local/share/ca-certificates
custom_ca_reload_interval="${ELASTIC_AGENT_CUSTOM_CA_RELOAD_INTERVAL:-30}"
[[ "$custom_ca_reload_interval" =~ ^[0-9]+$ ]] || custom_ca_reload_interval=30

# PEM files in the CA directory, one per line.
custom_ca_files() {
  local f
  for f in "$custom_ca_dir"/*.crt "$custom_ca_dir"/*.pem; do
    [[ -f "$f" ]] && echo "$f"
  done
  return 0
}

# Digest of the CA files' content, to detect changes.
custom_ca_signature() {
  local f
  { while IFS= read -r f; do cat "$f"; done < <(custom_ca_files); } 2>/dev/null | sha256sum | cut -d' ' -f1
}

# Make the NSS database match the CA directory. Certificates are named after
# their content, so unchanged ones are never touched and running browsers never
# see a gap.
sync_custom_cas() {
  local db="$HOME/.pki/nssdb"
  mkdir -p "$db" || true
  if [[ ! -f "$db/cert9.db" ]] && ! certutil -N -d "sql:$db" --empty-password; then
    echo "WARNING: could not create NSS database $db, skipping import of custom CAs" >&2
    return 0
  fi

  local tmp f pem name
  local -A want=()
  tmp=$(mktemp -d)
  while IFS= read -r f; do
    # certutil imports only the first certificate of a file: split bundles.
    awk -v dir="$tmp" -v base="$(basename "$f")" '
      /-----BEGIN CERTIFICATE-----/ { n++; out = dir "/" base "." n ".pem" }
      out { print > out }
      /-----END CERTIFICATE-----/ { out = "" }' "$f"
  done < <(custom_ca_files)
  for pem in "$tmp"/*.pem; do
    [[ -f "$pem" ]] || continue
    name="custom-ca-$(sha256sum "$pem" | cut -c1-16)"
    want[$name]=$pem
  done

  local existing added=0 removed=0
  existing=$(certutil -L -d "sql:$db" | awk '/^custom-ca-/ { print $1 }')
  for name in "${!want[@]}"; do
    grep -qx "$name" <<<"$existing" && continue
    if certutil -A -d "sql:$db" -n "$name" -t "C,," -i "${want[$name]}"; then
      added=$((added + 1))
    else
      echo "WARNING: failed to import $(basename "${want[$name]}") from $custom_ca_dir" >&2
    fi
  done
  for name in $existing; do
    [[ -n "${want[$name]:-}" ]] && continue
    if certutil -D -d "sql:$db" -n "$name"; then
      removed=$((removed + 1))
    fi
  done
  rm -r "$tmp"
  echo "Custom CA certificates in the browser trust store: ${#want[@]} (added $added, removed $removed)"
}

if ! command -v certutil >/dev/null; then
  [[ -z "$(custom_ca_files)" ]] ||
    echo "WARNING: certutil not found, skipping import of custom CAs from $custom_ca_dir" >&2
else
  custom_ca_last=$(custom_ca_signature)
  if [[ -n "$(custom_ca_files)" ]]; then
    # Chromium finds the database through $HOME, which is a read-only "/" for
    # arbitrary UIDs (e.g. OpenShift). Fix it before the agent, and so Chromium, starts.
    [[ -w "${HOME:-}" ]] || export HOME={{ $beatHome }}
    sync_custom_cas
  fi
  if (( custom_ca_reload_interval > 0 )); then
    (
      while sleep "$custom_ca_reload_interval"; do
        custom_ca_current=$(custom_ca_signature)
        if [[ "$custom_ca_current" != "$custom_ca_last" ]]; then
          custom_ca_last=$custom_ca_current
          sync_custom_cas || true
        fi
      done
    ) &
  fi
fi
{{- end }}

if [[ "$ELASTIC_AGENT_OTEL" == "true" ]]
then
exec {{ .BeatName }} otel "$@"
else
exec {{ .BeatName }} container "$@"
fi
