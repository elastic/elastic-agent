{{- $beatHome := printf "%s/%s" "/usr/share" .BeatName -}}
#!/bin/bash

# Update umask to retain group write permissions on runtime directories: $root/tmp/default, $root/logs/default and $root/run/default
umask 0007

set -eo pipefail

# For information on the possible environment variables that can be passed into the container. Run the following
# command for information on the options that are available.
#
# `./elastic-agent container --help`
#

{{- if contains .Variant "complete" }}
# Chromium (browser monitors) only trusts its own NSS database, not the system
# certificate store. Import any CA mounted into the standard location so users
# don't need a custom image. A bad certificate only logs a warning; it must
# not stop the agent from starting.
import_custom_cas() {
  local dir=/usr/local/share/ca-certificates
  local files=() f
  for f in "$dir"/*.crt "$dir"/*.pem; do
    [[ -f "$f" ]] && files+=("$f")
  done
  (( ${#files[@]} )) || return 0

  if ! command -v certutil >/dev/null; then
    echo "WARNING: certutil not found, skipping import of custom CAs from $dir" >&2
    return 0
  fi

  # Chromium looks for the database under $HOME, which is "/" (read-only) when
  # running as an arbitrary UID, e.g. on OpenShift.
  if [[ ! -w "${HOME:-}" ]]; then
    export HOME={{ $beatHome }}
  fi

  local db="$HOME/.pki/nssdb"
  mkdir -p "$db" || true
  if [[ ! -f "$db/cert9.db" ]] && ! certutil -N -d "sql:$db" --empty-password; then
    echo "WARNING: could not create NSS database $db, skipping import of custom CAs" >&2
    return 0
  fi

  local tmp n=0 pem
  tmp=$(mktemp -d)
  for f in "${files[@]}"; do
    # certutil imports only the first certificate of a file, so split bundles.
    awk -v dir="$tmp" -v base="$(basename "$f")" '
      /-----BEGIN CERTIFICATE-----/ { n++; out = dir "/" base "." n ".pem" }
      out { print > out }
      /-----END CERTIFICATE-----/ { out = "" }' "$f"
  done
  for pem in "$tmp"/*.pem; do
    [[ -f "$pem" ]] || continue
    n=$((n + 1))
    # Drop any previous import (persisted $HOME) so re-imports don't fail.
    certutil -D -d "sql:$db" -n "custom-ca-$(basename "$pem")" 2>/dev/null || true
    certutil -A -d "sql:$db" -n "custom-ca-$(basename "$pem")" -t "C,," -i "$pem" ||
      echo "WARNING: failed to import $(basename "$pem") from $dir" >&2
  done
  echo "Imported $n custom CA certificate(s) from $dir into the browser trust store"
  rm -r "$tmp"
}

import_custom_cas
{{- end }}

if [[ "$ELASTIC_AGENT_OTEL" == "true" ]]
then
exec {{ .BeatName }} otel "$@"
else
exec {{ .BeatName }} container "$@"
fi
